#!/usr/bin/env bash
# Hook entrypoint. Called by agent adapters on lifecycle events.
# Usage: tmux-ai-notify <event> <pane_id> [k=v ...]
#
# Intentionally swallows errors so a broken hook cannot freeze the agent.

set -u
_SELF="$({ readlink -f "$0" 2>/dev/null; } || { realpath "$0" 2>/dev/null; } || echo "$0")"
_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
TMUX_AI_LIB="${TMUX_AI_LIB:-$(cd "$_BIN_DIR/../lib" && pwd)}"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/common.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/state.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/config.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/notify.sh"

_last_assistant_text() {
  # Read the transcript (JSONL, one message per line) and emit the text
  # of the LAST text-block in the LAST assistant message. Empty if the
  # file doesn't exist, has no assistant text, or is malformed. Scans
  # only the last 500 lines to stay cheap on long sessions.
  local transcript="$1"
  [ -n "$transcript" ] && [ -f "$transcript" ] || return 0
  tail -n 500 "$transcript" 2>/dev/null \
    | awk '/"type":"assistant"/{last=$0} END{if(last!="")print last}' \
    | jq -r '.message.content // [] | [.[] | select(.type=="text") | .text] | last // empty' 2>/dev/null
}

_ends_with_question() {
  # True iff the (possibly multi-line) text ends in "?" after stripping
  # trailing whitespace. Used to classify a Stop event as "turn ended
  # with a question to the user" vs "turn genuinely done".
  local text="$1"
  [[ "$text" =~ \?[[:space:]]*$ ]]
}

main() {
  local event="${1:-}" pane="${2:-}"
  [ -n "$event" ] && [ -n "$pane" ] || { tmux_ai_log "notify: missing args"; return 0; }
  shift 2 || true

  # Claude Code pipes event JSON to hook commands via stdin. Read it
  # best-effort — manual invocations or tests without a pipe leave it
  # empty, in which case we fall through to legacy behavior.
  local hook_json=""
  if [ ! -t 0 ]; then
    hook_json="$(cat 2>/dev/null || true)"
  fi

  local agent project now
  agent="$(state_get "$pane" agent)"
  project="$(state_get "$pane" project)"
  now="$(date +%s)"

  case "$event" in
    session_start)
      state_set "$pane" state idle
      state_set "$pane" last_byte_ts "$now"
      ;;
    prompt_submit)
      state_set "$pane" state working
      state_set "$pane" turn_started_ts "$now"
      state_set "$pane" last_byte_ts "$now"
      ;;
    tool_use)
      # Fires from Claude's PreToolUse hook, right after the user
      # approves a tool-permission prompt (or immediately, for
      # auto-approved tools). Without this, state wedges on "waiting"
      # for the rest of the turn. Guarded so a late/out-of-order event
      # can't resurrect a pane the Stop hook already marked done.
      local cur_state
      cur_state="$(state_get "$pane" state)"
      state_set "$pane" last_byte_ts "$now"
      if [ "$cur_state" != "done" ]; then
        state_set "$pane" state working
      fi
      ;;
    stop)
      # Stop fires whenever the assistant turn ends — including when the
      # turn ends with a plain-text question (e.g., superpowers skills
      # like brainstorming). Inspect the transcript to tell "I'm done"
      # from "I'm waiting on an answer".
      state_set "$pane" last_byte_ts "$now"
      local transcript_path last_text
      transcript_path="$(printf '%s' "$hook_json" | jq -r '.transcript_path // empty' 2>/dev/null)"
      last_text="$(_last_assistant_text "$transcript_path")"
      if _ends_with_question "$last_text"; then
        state_set "$pane" state waiting
        notify_desktop "${agent:-agent} — needs input" "${project:-(unknown project)}"
        notify_sound waiting
        notify_push "${agent:-agent} — needs input" "${project:-(unknown project)}"
      else
        state_set "$pane" state done
        notify_desktop "${agent:-agent} — done" "${project:-(unknown project)}"
        notify_sound done
        notify_push "${agent:-agent} — done" "${project:-(unknown project)}"
      fi
      ;;
    notification)
      # Claude fires Notification for BOTH mid-turn permission prompts
      # (legitimately "waiting for input") and post-turn idle UI like the
      # feedback prompt — which arrives after Stop and would otherwise
      # wedge the dashboard on "waiting" forever. Only transition when
      # the turn is actually in progress.
      local cur_state
      cur_state="$(state_get "$pane" state)"
      state_set "$pane" last_byte_ts "$now"
      if [ "$cur_state" = "working" ] || [ "$cur_state" = "waiting" ]; then
        state_set "$pane" state waiting
        notify_desktop "${agent:-agent} — needs input" "${project:-(unknown project)}"
        notify_sound waiting
        notify_push "${agent:-agent} — needs input" "${project:-(unknown project)}"
      fi
      ;;
    stuck)
      state_set "$pane" state stuck
      notify_desktop "${agent:-agent} — stuck" "${project:-(unknown project)}"
      notify_sound stuck
      ;;
    pane_exited)
      # Drop the per-pane claude settings file too — otherwise the
      # runtime dir accumulates orphan JSON files for every agent pane
      # that has ever existed. rm is idempotent: panes registered with
      # the generic/observer adapter never had a settings file, so this
      # is a no-op for them.
      rm -f "$(tmux_ai_runtime_dir)/claude-settings/${pane//\//_}.json" 2>/dev/null || true
      state_unregister "$pane"
      ;;
    *)
      tmux_ai_log "notify: unknown event '$event' for pane $pane"
      ;;
  esac
  return 0
}

{ main "$@"; } 2>>"$XDG_STATE_HOME/tmux-ai/tmux-ai.log" || true

# Force an immediate status-bar repaint so the glyph counts reflect the
# state change within milliseconds instead of waiting up to status-interval
# (default 2s) for the next tick. Best-effort: harmless outside tmux.
tmux refresh-client -S 2>/dev/null || true

exit 0
