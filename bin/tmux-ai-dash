#!/usr/bin/env bash
set -u
_SELF="$({ readlink -f "${BASH_SOURCE[0]}" 2>/dev/null; } || { realpath "${BASH_SOURCE[0]}" 2>/dev/null; } || echo "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
TMUX_AI_LIB="${TMUX_AI_LIB:-$(cd "$_BIN_DIR/../lib" && pwd)}"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/common.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/state.sh"

fmt_elapsed() {
  local start="${1:-0}" now="${2:-}" diff hh mm ss
  [ "$start" -eq 0 ] && { printf '   -    '; return; }
  [ -z "$now" ] && now=$(date +%s)
  diff=$((now - start))
  hh=$((diff / 3600))
  mm=$(( (diff % 3600) / 60 ))
  ss=$((diff % 60))
  if [ "$hh" -gt 0 ]; then
    # h:mm:ss rolls over to hh:mm:ss above 10h — max 8 chars.
    printf '%d:%02d:%02d' "$hh" "$mm" "$ss"
  else
    printf '   %02d:%02d' "$mm" "$ss"
  fi
}

# Truncate to N visible chars, adding … when clipped.
_dash_trunc() {
  local s="$1" n="$2"
  if [ "${#s}" -le "$n" ]; then
    printf '%s' "$s"
  else
    printf '%s…' "${s:0:$((n - 1))}"
  fi
}

# Compute column widths. Fixed cells: state=7, agent=12, winpane=10,
# elapsed=8, cursor=1. With 5 two-space gaps + the 2-char frame, that's
# 51 chars before the project column. We give PROJECT whatever remains
# (clamped 8–30) so it doesn't sprawl on wide monitors.
#
# Emits "content_w agent_w project_w" on stdout.
_dash_layout() {
  local cols project_w content_w
  cols=$(tput cols 2>/dev/null || echo 80)
  local avail=$(( cols - 2 ))     # leave a 1-char margin each side
  [ "$avail" -lt 55 ] && avail=55
  project_w=$(( avail - 51 ))
  [ "$project_w" -lt 8 ]  && project_w=8
  [ "$project_w" -gt 30 ] && project_w=30
  content_w=$(( 51 + project_w ))
  printf '%d %d %d' "$content_w" 12 "$project_w"
}

# Truecolor palette — driven by @tmux-ai-* options via load_palette.
load_palette
_DASH_RESET="$C_RESET"
_DASH_DIM="$C_DIM_ATTR"
_DASH_ACCENT="${C_ACCENT}${C_BOLD}"
_DASH_MUTED="$C_DIM"
_dash_color_for() {
  case "$1" in
    working) printf '%s' "$C_WAIT"  ;;
    waiting) printf '%s' "$C_ACCENT" ;;
    done)    printf '%s' "$C_OK"    ;;
    stuck)   printf '%s' "$C_STUCK" ;;
    error)   printf '%s%s' "$C_STUCK" "$C_BOLD" ;;
    *)       printf '%s' "$C_DIM_ATTR" ;;
  esac
}

render() {
  # state_init only when called outside the interactive loop — inside
  # the loop we validate once up front and skip re-validating on every
  # keystroke (40ms jq -e fork).
  [ -z "${TMUX_AI_DASH_SKIP_INIT:-}" ] && state_init
  local file; file="$(_state_file)"

  # One jq pass pulls every row as TSV. Row count comes from array length
  # so we can drop a separate `jq 'length'` call (saves ~40ms / render).
  local rows=() line
  while IFS= read -r line; do rows+=("$line"); done < <(jq -r '
    to_entries[] |
    [.key,
     (.value.state // "?"),
     (.value.agent // "?"),
     (.value.project // "?"),
     (.value.window // "?"),
     (.value.pane_index // "?"),
     (.value.turn_started_ts // 0 | tostring)
    ] | @tsv
  ' "$file" 2>/dev/null)
  local count=${#rows[@]}

  # Reuse the interactive-loop's cached layout if present (avoids a
  # `tput cols` fork on every keystroke); fall back to a fresh compute
  # for --render mode or first call.
  local content_w agent_w project_w
  if [ -n "${TMUX_AI_DASH_LAYOUT_CACHE:-}" ]; then
    read -r content_w agent_w project_w <<< "$TMUX_AI_DASH_LAYOUT_CACHE"
  else
    read -r content_w agent_w project_w < <(_dash_layout)
  fi
  local state_w=7 winpane_w=10 elapsed_w=8
  local dash_w=$(( content_w - 2 ))   # dashes inside the frame

  # Header
  local dnd_txt=""
  if [ -f "$XDG_RUNTIME_DIR/tmux-ai/dnd.flag" ]; then
    dnd_txt="  ${_DASH_ACCENT}◌ DND on${_DASH_RESET}"
  fi

  if [ "$count" -eq 0 ]; then
    printf '%stmux-ai — no agents registered%s%s\n\n' "$_DASH_ACCENT" "$_DASH_RESET" "$dnd_txt"
    printf '%s[q] quit%s\n' "$_DASH_MUTED" "$_DASH_RESET"
    return 0
  fi

  # Border-drawing helper — emits N horizontal dashes.
  local i
  local _draw_dashes=""
  _draw_dashes=$(printf '%*s' "$dash_w" '' | tr ' ' '-' | sed 's/-/─/g')

  # Top frame with inline title: ┌─ tmux-ai — N agents [dnd] ─…┐
  # The title itself replaces the leading dashes; we pad the rest.
  local title=" tmux-ai — ${count} agents${dnd_txt} "
  # Visible length of the title, ignoring the ANSI escapes inside dnd_txt.
  local title_visible_len
  title_visible_len=$(printf '%s' "$title" | sed -E $'s/\x1b\\[[0-9;]*m//g' | awk '{print length}')
  local pad_len=$(( dash_w - title_visible_len - 1 ))
  [ "$pad_len" -lt 0 ] && pad_len=0
  printf '%s┌─%s' "$_DASH_ACCENT" "$_DASH_RESET"
  printf '%b' "$title"
  printf '%s' "$_DASH_ACCENT"
  for i in $(seq 1 "$pad_len"); do printf '─'; done
  printf '┐%s\n' "$_DASH_RESET"

  # Column header
  printf '│ %s %-*s  %-*s  %-*s  %-*s  %-*s │\n' \
    " " "$state_w" "STATE" "$agent_w" "AGENT" "$project_w" "PROJECT" \
    "$winpane_w" "WIN:PANE" "$elapsed_w" "ELAPSED"

  # Row separator
  printf '%s├' "$_DASH_ACCENT"
  for i in $(seq 1 "$dash_w"); do printf '─'; done
  printf '┤%s\n' "$_DASH_RESET"

  # Rows — iterate the already-parsed TSV array. Truncation + elapsed
  # formatting are inlined rather than calling helper functions via
  # $(...) because each command substitution forks a subshell, and that
  # fork cost (~5ms × ~4 calls × N rows) was dominating render latency.
  local now; now=$(date +%s 2>/dev/null || echo 0)
  local pane state agent project win pane_idx turn color cursor
  local _dash_cursor_emitted=""
  local row agent_t project_t winpane elapsed diff hh mm ss
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r pane state agent project win pane_idx turn <<< "$row"

    case "$state" in
      working) color="$C_WAIT" ;;
      waiting) color="$C_ACCENT" ;;
      done)    color="$C_OK" ;;
      stuck)   color="$C_STUCK" ;;
      error)   color="${C_STUCK}${C_BOLD}" ;;
      *)       color="$C_DIM_ATTR" ;;
    esac

    if [ "$pane" = "${TMUX_AI_DASH_SELECTED:-}" ]; then
      cursor="▸"
    elif [ -z "${TMUX_AI_DASH_SELECTED:-}" ] && [ -z "$_dash_cursor_emitted" ]; then
      cursor="▸"
      _dash_cursor_emitted=1
    else
      cursor=" "
    fi

    # Inline truncate (bash builtins only).
    agent_t="$agent"
    [ "${#agent_t}" -gt "$agent_w" ] && agent_t="${agent_t:0:$((agent_w - 1))}…"
    project_t="$project"
    [ "${#project_t}" -gt "$project_w" ] && project_t="${project_t:0:$((project_w - 1))}…"
    winpane="$win:$pane_idx"
    [ "${#winpane}" -gt "$winpane_w" ] && winpane="${winpane:0:$((winpane_w - 1))}…"

    # Inline fmt_elapsed.
    if [ "$turn" -eq 0 ] 2>/dev/null; then
      elapsed='   -    '
    else
      diff=$((now - turn))
      hh=$((diff / 3600))
      mm=$(( (diff % 3600) / 60 ))
      ss=$((diff % 60))
      if [ "$hh" -gt 0 ]; then
        printf -v elapsed '%d:%02d:%02d' "$hh" "$mm" "$ss"
      else
        printf -v elapsed '   %02d:%02d' "$mm" "$ss"
      fi
    fi

    printf '│ %s %s%-*s%s  %-*s  %-*s  %-*s  %-*s │\n' \
      "$cursor" "$color" "$state_w" "$state" "$_DASH_RESET" \
      "$agent_w" "$agent_t" "$project_w" "$project_t" \
      "$winpane_w" "$winpane" "$elapsed_w" "$elapsed"
  done

  # Bottom
  printf '%s└' "$_DASH_ACCENT"
  for i in $(seq 1 "$dash_w"); do printf '─'; done
  printf '┘%s\n' "$_DASH_RESET"

  # Footer
  printf '\n%s[j/k] select  [Enter] jump  [q] quit%s\n' "$_DASH_MUTED" "$_DASH_RESET"
}

# Jump straight to the agent's pane. Targeting the pane id resolves to
# session+window+pane in one shot, so we land exactly where the agent is
# running instead of on the session's last-active pane.
dash_jump() {
  local pane="$1"
  [ -n "$pane" ] || return 0
  tmux switch-client -t "$pane" 2>/dev/null || true
  tmux select-pane  -t "$pane" 2>/dev/null || true
}

# --render: just emit one frame and exit (used by tests)
if [ "${1:-}" = "--render" ]; then
  render
  exit 0
fi

# Interactive mode: open display-popup that runs this script on a refresh loop.
# Redraws in-place only when the rendered frame actually changes — avoids the
# clear+repaint flicker that makes the dashboard feel like it's reloading.
interactive_loop() {
  printf '\033[?25l'
  trap 'printf "\033[?25h\033[2J\033[H"; exit' EXIT INT TERM

  printf '\033[2J\033[H'

  # Validate state file once up front; render() skips its own state_init
  # so it doesn't fork `jq -e .` on every keystroke.
  state_init
  export TMUX_AI_DASH_SKIP_INIT=1

  # Cache the layout once — the terminal/popup only resizes on WINCH,
  # so there's no reason to fork `tput cols` on every keystroke.
  TMUX_AI_DASH_LAYOUT_CACHE="$(_dash_layout)"
  export TMUX_AI_DASH_LAYOUT_CACHE

  local selected last_hash="" frame cur_hash key
  selected="$(state_list | head -n 1)"

  # Recompute layout + force full redraw when the popup resizes.
  trap 'TMUX_AI_DASH_LAYOUT_CACHE="$(_dash_layout)"; last_hash=""' WINCH

  while true; do
    TMUX_AI_DASH_SELECTED="$selected" \
      frame="$(render)"
    cur_hash="${#frame}:$(printf '%s' "$frame" | cksum)"

    if [ "$cur_hash" != "$last_hash" ]; then
      printf '\033[H%s\033[J' "$frame"
      last_hash="$cur_hash"
    fi

    # 0.1s poll = 10 Hz. Keystrokes feel instant; CPU cost negligible
    # because render() only re-emits when the frame hash actually changes.
    if read -t 0.1 -n 1 -s key 2>/dev/null; then
      case "$key" in
        q|Q) exit 0 ;;
        j)
          local next
          next="$(state_list | awk -v cur="$selected" '{if (prev==cur) {print; exit} prev=$0}')"
          [ -n "$next" ] && selected="$next"
          ;;
        k)
          local prev
          prev="$(state_list | awk -v cur="$selected" '{if ($0==cur) {print last; exit} last=$0}')"
          [ -n "$prev" ] && selected="$prev"
          ;;
        [1-9])
          local nth
          nth="$(state_list | sed -n "${key}p")"
          [ -n "$nth" ] && selected="$nth"
          ;;
        '')
          dash_jump "$selected"
          exit 0
          ;;
      esac
    fi
  done
}

# Only run entrypoint when executed, not when sourced (for tests).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  if [ "${1:-}" = "--loop" ]; then
    interactive_loop
  elif [ -n "${TMUX:-}" ]; then
    tmux display-popup -w 90% -h 80% -E "$_SELF --loop"
  else
    render
  fi
fi
