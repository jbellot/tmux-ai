#!/usr/bin/env bash
set -u
_SELF="$({ readlink -f "$0" 2>/dev/null; } || { realpath "$0" 2>/dev/null; } || echo "$0")"
_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
TMUX_AI_LIB="${TMUX_AI_LIB:-$(cd "$_BIN_DIR/../lib" && pwd)}"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/common.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/state.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/config.sh"

# Glyphs (plain Unicode — no Nerd Font assumed).
GLYPH_DONE='●'
GLYPH_WAIT='◐'   # waiting for user input
GLYPH_WORK='◑'   # working (turn in flight)
GLYPH_STUCK='▲'

render() {
  state_init
  local file; file="$(_state_file)"

  # One jq pass tallies all four state-counts plus the total. Avoids five
  # interpreter startups per status-interval tick.
  local counts
  counts=$(jq -r '[
    ([.[] | select(.state=="done")]    | length),
    ([.[] | select(.state=="waiting")] | length),
    ([.[] | select(.state=="working")] | length),
    ([.[] | select(.state=="stuck")]   | length)
  ] | @tsv' "$file" 2>/dev/null) || counts=$'0\t0\t0\t0'

  local d wa w s
  IFS=$'\t' read -r d wa w s <<< "${counts:-0	0	0	0}"

  if [ $((d + wa + w + s)) -eq 0 ]; then
    return 0
  fi

  local col_done col_waiting col_working col_stuck
  col_done=$(_tmux_opt    @tmux-ai-ok     '#98bb6c')
  col_waiting=$(_tmux_opt @tmux-ai-accent '#7e9cd8')
  col_working=$(_tmux_opt @tmux-ai-wait   '#dca561')
  col_stuck=$(_tmux_opt   @tmux-ai-stuck  '#e82424')

  local out=""
  [ "$d"  -gt 0 ] && out+="#[fg=${col_done}]${GLYPH_DONE}${d} "
  [ "$wa" -gt 0 ] && out+="#[fg=${col_waiting}]${GLYPH_WAIT}${wa} "
  [ "$w"  -gt 0 ] && out+="#[fg=${col_working}]${GLYPH_WORK}${w} "
  [ "$s"  -gt 0 ] && out+="#[fg=${col_stuck}]${GLYPH_STUCK}${s} "

  printf '%s' "${out% }"
}

mkdir -p "$XDG_STATE_HOME/tmux-ai" 2>/dev/null || true
{
  render
  if [ -z "${TMUX_AI_STATUS_NO_DETECT:-}" ]; then
    "$_BIN_DIR/tmux-ai-detect" </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
} 2>>"$XDG_STATE_HOME/tmux-ai/tmux-ai.log" || true
exit 0
