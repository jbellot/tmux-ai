#!/usr/bin/env bash
set -u
_SELF="$({ readlink -f "$0" 2>/dev/null; } || { realpath "$0" 2>/dev/null; } || echo "$0")"
_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
TMUX_AI_LIB="${TMUX_AI_LIB:-$(cd "$_BIN_DIR/../lib" && pwd)}"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/common.sh"

flag="$(tmux_ai_runtime_dir)/dnd.flag"
case "${1:-toggle}" in
  on)     touch "$flag" ;;
  off)    rm -f "$flag" ;;
  toggle) [ -f "$flag" ] && rm -f "$flag" || touch "$flag" ;;
  status) [ -f "$flag" ] && echo on || echo off ;;
  *) echo "usage: tmux-ai-dnd on|off|toggle|status" >&2; exit 2 ;;
esac
exit 0
