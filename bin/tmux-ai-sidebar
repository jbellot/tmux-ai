#!/usr/bin/env bash
# tmux-ai sidebar — narrow-pane live status view.
# Task 6 ships the renderer only (interactive loop lands in Task 7).

set -u

_SELF="$({ readlink -f "${BASH_SOURCE[0]}" 2>/dev/null; } || { realpath "${BASH_SOURCE[0]}" 2>/dev/null; } || echo "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
TMUX_AI_LIB="${TMUX_AI_LIB:-$(cd "$_BIN_DIR/../lib" && pwd)}"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/common.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/state.sh"
# shellcheck source=/dev/null
source "$TMUX_AI_LIB/config.sh"

# Truecolor palette — driven by @tmux-ai-* options via load_palette.
load_palette
ANSI_RESET="$C_RESET"
ANSI_DIM="$C_DIM_ATTR"
ANSI_BOLD="$C_BOLD"
C_WORK="$C_WAIT"
C_WAIT_STATE="$C_ACCENT"
C_DONE="$C_OK"
# C_STUCK already set by load_palette
C_ERROR="${C_STUCK}${C_BOLD}"
C_IDLE="$C_DIM_ATTR"
# C_ACCENT already set by load_palette
C_MUTED="$C_DIM"

ICON_WORK="⚙"   # working — matches status-bar GLYPH_WORK
ICON_WAIT="⏸"   # waiting for user input — matches status-bar GLYPH_WAIT
ICON_DONE="✓"   # done / ready — matches status-bar GLYPH_DONE
ICON_STUCK="✗"  # stuck — matches status-bar GLYPH_STUCK
ICON_ERROR="!"  # error — distinct glyph; color_for still adds bold on red
ICON_IDLE="·"   # idle — unchanged
CURSOR="▸"
CURSOR_EMPTY=" "

sidebar_width() {
  local w
  # Reuse the interactive-loop cache to avoid forking tmux show-options
  # on every keystroke.
  if [ -n "${TMUX_AI_SIDEBAR_WIDTH_CACHE:-}" ]; then
    printf '%s\n' "$TMUX_AI_SIDEBAR_WIDTH_CACHE"
    return 0
  fi
  w="$(tmux show-options -gv @tmux-ai-sidebar-width 2>/dev/null || true)"
  [ -n "$w" ] || w=32
  printf '%s\n' "$w"
}

color_for() {
  case "$1" in
    working) printf '%s' "$C_WORK" ;;
    waiting) printf '%s' "$C_WAIT_STATE" ;;
    done)    printf '%s' "$C_DONE" ;;
    stuck)   printf '%s' "$C_STUCK" ;;
    error)   printf '%s' "$C_ERROR" ;;
    idle|*)  printf '%s' "$C_IDLE" ;;
  esac
}

icon_for() {
  case "$1" in
    working) printf '%s' "$ICON_WORK" ;;
    waiting) printf '%s' "$ICON_WAIT" ;;
    done)    printf '%s' "$ICON_DONE" ;;
    stuck)   printf '%s' "$ICON_STUCK" ;;
    error)   printf '%s' "$ICON_ERROR" ;;
    idle|*)  printf '%s' "$ICON_IDLE" ;;
  esac
}

fmt_elapsed() {
  local start now diff mm ss hh
  start="${1:-0}"
  [ "$start" = "" ] && start=0
  [ "$start" -eq 0 ] && { printf '  -  '; return; }
  now=$(date +%s)
  diff=$((now - start))
  mm=$((diff / 60))
  ss=$((diff % 60))
  if [ "$mm" -ge 100 ]; then
    hh=$((mm / 60))
    mm=$((mm % 60))
    printf '%02d:%02d' "$hh" "$mm"
  else
    printf '%02d:%02d' "$mm" "$ss"
  fi
}

# Truncate a string to N visible chars, adding … if cut.
trunc() {
  local s="$1" n="$2"
  if [ "${#s}" -le "$n" ]; then
    printf '%s' "$s"
  else
    printf '%s…' "${s:0:$((n - 1))}"
  fi
}

render_empty() {
  local w; w=$(sidebar_width)
  local pad_center
  pad_center=$(( (w - 10) / 2 ))
  [ "$pad_center" -lt 0 ] && pad_center=0
  printf '\n\n%*sno agents\n\n' "$pad_center" ""
  pad_center=$(( (w - 19) / 2 ))
  [ "$pad_center" -lt 0 ] && pad_center=0
  printf '%s%*sprefix + A to spawn%s\n' "$C_MUTED" "$pad_center" "" "$ANSI_RESET"
}

render() {
  # state_init only when called outside the interactive loop (validate
  # once up front inside the loop via TMUX_AI_SIDEBAR_SKIP_INIT).
  [ -z "${TMUX_AI_SIDEBAR_SKIP_INIT:-}" ] && state_init
  local file; file="$(_state_file)"
  local selected="${TMUX_AI_SIDEBAR_SELECTED:-}"
  local w; w=$(sidebar_width)

  # One jq pass emits TSV for every row. Row count = array length, so
  # we drop the separate `jq 'length'` call.
  local rows=() line
  while IFS= read -r line; do rows+=("$line"); done < <(jq -r '
    to_entries[] |
    [.key,
     (.value.state // "idle"),
     (.value.project // .key),
     (.value.turn_started_ts // 0 | tostring)
    ] | @tsv
  ' "$file" 2>/dev/null)
  local count=${#rows[@]}

  if [ "$count" -eq 0 ]; then
    render_empty
    return 0
  fi

  # Title strip
  printf '%s%s agents%s\n' "$C_ACCENT" "$count" "$ANSI_RESET"
  printf '%s\n' "$(printf '%*s' "$w" '' | tr ' ' '─')"

  # One row per entry — helpers inlined to eliminate per-row $()
  # subshell forks (previously: icon_for + color_for + trunc +
  # fmt_elapsed × N rows; that's the main source of navigation lag).
  local proj_col=$(( w - 10 ))
  [ "$proj_col" -lt 4 ] && proj_col=4
  local now; now=$(date +%s 2>/dev/null || echo 0)
  local row pane state project turn icon color cursor project_t elapsed diff hh mm ss
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r pane state project turn <<< "$row"

    case "$state" in
      working) icon="$ICON_WORK";  color="$C_WORK" ;;
      waiting) icon="$ICON_WAIT";  color="$C_WAIT_STATE" ;;
      done)    icon="$ICON_DONE";  color="$C_DONE" ;;
      stuck)   icon="$ICON_STUCK"; color="$C_STUCK" ;;
      error)   icon="$ICON_ERROR"; color="$C_ERROR" ;;
      *)       icon="$ICON_IDLE";  color="$C_IDLE" ;;
    esac

    if [ "$pane" = "$selected" ]; then cursor="$CURSOR"; else cursor="$CURSOR_EMPTY"; fi

    # Inline trunc + left-pad.
    project_t="$project"
    [ "${#project_t}" -gt "$proj_col" ] && project_t="${project_t:0:$((proj_col - 1))}…"
    printf -v project_t '%-*s' "$proj_col" "$project_t"

    # Inline fmt_elapsed (matches existing sidebar format: mm:ss up to
    # 100 min, then hh:mm).
    if [ "$turn" -eq 0 ] 2>/dev/null; then
      elapsed='  -  '
    else
      diff=$((now - turn))
      mm=$((diff / 60))
      ss=$((diff % 60))
      if [ "$mm" -ge 100 ]; then
        hh=$((mm / 60))
        mm=$((mm % 60))
        printf -v elapsed '%02d:%02d' "$hh" "$mm"
      else
        printf -v elapsed '%02d:%02d' "$mm" "$ss"
      fi
    fi

    printf '%s %s%s%s %s %s\n' \
      "$cursor" "$color" "$icon" "$ANSI_RESET" "$project_t" "$elapsed"
  done

  # Footer
  printf '\n'
  printf '%s[j/k] move  [Enter] jump%s\n' "$C_MUTED" "$ANSI_RESET"
  printf '%s[d] unreg  [r] refresh%s\n' "$C_MUTED" "$ANSI_RESET"
}

# ========== Helpers used by the interactive loop ==========

# Return pane-id following the given one (wraps).
sidebar_next_pane() {
  local cur="$1" first="" prev="" found=0
  while IFS= read -r p; do
    [ -z "$first" ] && first="$p"
    if [ "$found" -eq 1 ]; then
      printf '%s\n' "$p"
      return 0
    fi
    [ "$p" = "$cur" ] && found=1
    prev="$p"
  done < <(state_list)
  printf '%s\n' "$first"
}

sidebar_prev_pane() {
  local cur="$1" prev="" last=""
  while IFS= read -r p; do
    if [ "$p" = "$cur" ] && [ -n "$prev" ]; then
      printf '%s\n' "$prev"
      return 0
    fi
    prev="$p"
    last="$p"
  done < <(state_list)
  # If cur is first (or absent) wrap to last
  printf '%s\n' "$last"
}

sidebar_nth_pane() {
  local n="$1" i=0
  while IFS= read -r p; do
    i=$((i + 1))
    if [ "$i" -eq "$n" ]; then
      printf '%s\n' "$p"
      return 0
    fi
  done < <(state_list)
  return 0
}

sidebar_first_pane() {
  state_list | head -n 1
}

# Jump straight to the agent's pane. Targeting the pane id resolves to
# session+window+pane in one shot, so we land exactly where the agent is
# running instead of on whatever the session's active pane happens to be.
sidebar_jump() {
  local pane="$1"
  [ -n "$pane" ] || return 0
  tmux switch-client -t "$pane" 2>/dev/null || true
  tmux select-pane  -t "$pane" 2>/dev/null || true
}

# ========== Interactive loop ==========

interactive_loop() {
  # Hide cursor; restore on exit.
  printf '\033[?25l'
  trap 'printf "\033[?25h\033[2J\033[H"; exit' EXIT INT TERM

  printf '\033[2J\033[H'

  # Validate the state file once up front; render() skips its own
  # state_init to avoid forking `jq -e .` on every keystroke.
  state_init
  export TMUX_AI_SIDEBAR_SKIP_INIT=1

  # Cache sidebar width (only changes when the user edits
  # @tmux-ai-sidebar-width and re-sources tmux.conf; a WINCH at that
  # point will refresh it).
  TMUX_AI_SIDEBAR_WIDTH_CACHE=$(tmux show-options -gv @tmux-ai-sidebar-width 2>/dev/null || true)
  [ -n "$TMUX_AI_SIDEBAR_WIDTH_CACHE" ] || TMUX_AI_SIDEBAR_WIDTH_CACHE=32
  export TMUX_AI_SIDEBAR_WIDTH_CACHE

  local selected last_hash="" frame cur_hash key
  selected="$(sidebar_first_pane)"

  # Force full redraw + refresh width cache on resize.
  trap 'TMUX_AI_SIDEBAR_WIDTH_CACHE=$(tmux show-options -gv @tmux-ai-sidebar-width 2>/dev/null || echo 32); last_hash=""' WINCH

  while true; do
    TMUX_AI_SIDEBAR_SELECTED="$selected" \
      frame="$(render)"
    cur_hash="${#frame}:$(printf '%s' "$frame" | cksum)"

    if [ "$cur_hash" != "$last_hash" ]; then
      printf '\033[H%s\033[J' "$frame"
      last_hash="$cur_hash"
    fi

    # 0.1s poll = 10 Hz. Render cache-diffs prevent wasted repaints.
    if read -t 0.1 -n 1 -s key 2>/dev/null; then
      case "$key" in
        j) selected="$(sidebar_next_pane "$selected")" ;;
        k) selected="$(sidebar_prev_pane "$selected")" ;;
        g) selected="$(sidebar_first_pane)" ;;
        G) selected="$(state_list | tail -n 1)" ;;
        [1-9])
          local nth
          nth="$(sidebar_nth_pane "$key")"
          if [ -n "$nth" ]; then
            selected="$nth"
            sidebar_jump "$selected"
          fi
          ;;
        '')  sidebar_jump "$selected" ;;
        r) last_hash="" ;;
        d)
          if [ -n "$selected" ]; then
            printf '\033[%d;1HUnregister %s? (y/n) ' "$(tput lines 2>/dev/null || echo 24)" "$selected"
            local confirm
            read -n 1 -s confirm
            if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
              state_unregister "$selected"
              selected="$(sidebar_first_pane)"
            fi
            last_hash=""
          fi
          ;;
        q) : ;;
      esac
    fi

    # If selected is gone, fall back to first.
    if [ -n "$selected" ] && [ -z "$(state_get "$selected" agent)" ]; then
      selected="$(sidebar_first_pane)"
      last_hash=""
    fi
  done
}

# Only run the entrypoint when executed, not when sourced (for tests).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  if [ "${1:-}" = "--render" ]; then
    render
    exit 0
  fi
  interactive_loop
fi
